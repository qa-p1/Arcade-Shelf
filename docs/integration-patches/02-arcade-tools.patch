+#[test]
+fn shelf_bundle_extraction_rejects_links_and_preserves_originals() {
+    let temp = tempfile::tempdir().unwrap();
+    let archive = temp.path().join("bundle.tar.gz");
+    bundle(&archive, false);
+    let (_guard, extracted) = platform::extract_shelf(&archive, &temp.path().join("downloads")).unwrap();
+    assert_eq!(std::fs::read_to_string(extracted.join("bin/arcade-shelf")).unwrap(), "binary");
+    assert!(archive.is_file());
+    bundle(&archive, true);
+    assert_eq!(platform::extract_shelf(&archive, &temp.path().join("downloads")).unwrap_err().code, "installer");
+}
