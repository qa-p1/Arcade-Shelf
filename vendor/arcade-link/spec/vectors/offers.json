{
  "comment": "Offers (SPEC \u00a75.5). Every case runs against `cards`. `expect` lists the offers in order by reference (<app>/<action>). Always compared: enabled (true when not listed), preferred, other, choose, pinned (false when not listed). Compared only when listed: rank, title, reason, install, group, oneClick. inputType: the type a selection is offered as (null: none).",
  "cards": [
    {
      "schema": 1,
      "id": "arcade.box",
      "name": "Arcade Box",
      "executable": "/x",
      "actions": [
        {
          "id": "box:image.convert",
          "title": "Convert images",
          "accepts": [
            "file/image",
            "file/image[]"
          ],
          "rank": {
            "file/image": 70
          },
          "job": "image.convert",
          "oneClick": true,
          "group": "Images",
          "effects": [
            "writes-files"
          ]
        },
        {
          "id": "box:image.ocr",
          "title": "Read text",
          "accepts": [
            "file/image"
          ],
          "rank": {
            "file/image": 40
          },
          "job": "image.read-text"
        },
        {
          "id": "box:media.compress",
          "title": "Compress video",
          "accepts": [
            "file/video"
          ],
          "available": false,
          "reason": "FFmpeg isn't installed",
          "requires": [
            "engine:ffmpeg"
          ]
        },
        {
          "id": "box:pdf.merge",
          "title": "Merge PDFs",
          "accepts": [
            "file/pdf[]"
          ],
          "maxItems": 50,
          "rank": {
            "file/pdf": 50
          }
        },
        {
          "id": "box:sheet.convert",
          "title": "Convert spreadsheet",
          "accepts": [
            "file/spreadsheet"
          ]
        },
        {
          "id": "box:broken",
          "title": "Broken",
          "accepts": [
            "file/image"
          ],
          "available": false,
          "reason": "Missing"
        },
        {
          "id": "box.open",
          "title": "Open in Arcade Box",
          "accepts": [
            "*"
          ],
          "interactive": true
        }
      ]
    },
    {
      "schema": 1,
      "id": "arcade.lens",
      "name": "Arcade Lens",
      "executable": "/x",
      "actions": [
        {
          "id": "lens.recognize",
          "title": "Recognize text",
          "accepts": [
            "file/image",
            "text/plain"
          ],
          "featuredFor": [
            "file/image"
          ],
          "job": "image.read-text"
        }
      ]
    },
    {
      "schema": 1,
      "id": "arcade.clipboard",
      "name": "Arcade Clipboard",
      "executable": "/x",
      "actions": [
        {
          "id": "clipboard.add",
          "title": "Send to phone",
          "accepts": [
            "text/*",
            "file/image",
            "file/any[]"
          ],
          "maxBytes": 16777216,
          "effects": [
            "sends-to-device"
          ]
        }
      ]
    },
    {
      "schema": 1,
      "id": "arcade.wheel",
      "name": "Arcade Wheel",
      "executable": "/x",
      "settings": {
        "linkEnabled": false
      },
      "actions": [
        {
          "id": "wheel.add_action",
          "title": "Add to wheel",
          "accepts": [
            "file/*"
          ]
        }
      ]
    },
    {
      "schema": 1,
      "id": "arcade.shelf",
      "name": "Arcade Shelf",
      "executable": "/x",
      "actions": [
        {
          "id": "shelf.add",
          "title": "Keep on shelf",
          "accepts": [
            "file/*",
            "file/*[]",
            "folder/reference",
            "text/plain"
          ],
          "surfaces": [
            "file-menu",
            "palette"
          ]
        }
      ]
    },
    {
      "schema": 1,
      "id": "arcade.find",
      "name": "Arcade Find",
      "executable": "/x",
      "actions": [
        {
          "id": "find.show",
          "title": "Search files",
          "accepts": [],
          "interactive": true
        },
        {
          "id": "find.terminal",
          "title": "Run in terminal",
          "accepts": [
            "text/plain;hint=command"
          ]
        }
      ]
    }
  ],
